def bar(cv, x, y, w, label, val):
    cv.put(x, y, label.ljust(6), INKD)
    bw = max(4, w - 6 - 6)
    fill = int(val / 100.0 * bw)
    col = RED if val > 85 else AMBER if val > 65 else GREEN
    cv.put(x + 6, y, "[", GDIM)
    cv.put(x + 7, y, "█" * fill, col)
    cv.put(x + 7 + fill, y, "░" * (bw - fill), GDEEP)
    cv.put(x + 7 + bw, y, "]", GDIM)
    cv.put(x + 8 + bw, y, "{:>3.0f}%".format(val), col)

