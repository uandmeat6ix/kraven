def update_gauges():
    inten = S.intensity
    if S.frame % 14 == 0:
        base = {"CPU": (30, 50, 45), "MEM": (35, 55, 35), "NET": (20, 45, 50),
                "GPU": (10, 30, 65), "CRYPT": (25, 55, 40)}
        for k, (lo, hi, sc) in base.items():
            S.g[k][1] = rflt(lo, hi) + inten * sc
    for k in S.g:
        v, t = S.g[k]
        v += (t - v) * 0.12 + rflt(-1.5, 1.5)
        S.g[k][0] = max(2, min(99, v))

def update_ports():
    if S.paused:
        return
    if S.frame % 7 != 0:
        return
    if S.pidx >= len(PORTS):
        S.pidx = 0
    row = PORTS[S.pidx]
    S.pidx += 1
    S.pscanned = min(65535, S.pscanned + rint(1800, 6400))
    S.prows.append(row)
    if len(S.prows) > 40:
        S.prows = S.prows[-40:]

def update_hex():
    if S.paused:
        return
    if S.frame % 2 != 0:
        return
    b = [hexs(2) for _ in range(16)]
    ascii_ = "".join(random.choice(".·#@%x><$") if random.random() < 0.4
                     else chr(rint(65, 122)) for _ in range(16))
    line = "{:08x}  {}  {}  |{}|".format(
        S.hex_off & 0xffffffff, " ".join(b[:8]), " ".join(b[8:]), ascii_)
    S.hex_off += 16
    S.hex_lines.append(line)
    if len(S.hex_lines) > 60:
        S.hex_lines = S.hex_lines[-60:]
    if S.frame % 12 == 0:
        S.exrate = rint(120, 980)

