# ----------------------------------------------------------------------------
# Terminal canvas: compone todo el frame en memoria y lo escribe de una,
# para eliminar el parpadeo. Cada celda guarda (caracter, color).
# ----------------------------------------------------------------------------
class Canvas:
    def __init__(self, w, h):
        self.resize(w, h)

    def resize(self, w, h):
        self.w = max(1, w)
        self.h = max(1, h)
        self.ch = [[" "] * self.w for _ in range(self.h)]
        self.co = [[BASE] * self.w for _ in range(self.h)]

    def clear(self):
        for y in range(self.h):
            row = self.ch[y]
            crow = self.co[y]
            for x in range(self.w):
                row[x] = " "
                crow[x] = BASE

    def put(self, x, y, text, color):
        if y < 0 or y >= self.h:
            return
        row = self.ch[y]
        crow = self.co[y]
        xx = x
        for c in text:
            if 0 <= xx < self.w:
                row[xx] = c
                crow[xx] = color
            xx += 1

    def segs(self, x, y, segments, maxw):
        """Dibuja una lista de (texto,color) recortada a maxw."""
        used = 0
        cx = x
        for text, color in segments:
            if used >= maxw:
                break
            room = maxw - used
            t = text[:room]
            self.put(cx, y, t, color)
            cx += len(t)
            used += len(t)

    def box(self, x, y, w, h, color, title="", tcolor=None):
        if w < 2 or h < 2:
            return
        hz = "─" * (w - 2)
        self.put(x, y, "┌" + hz + "┐", color)
        self.put(x, y + h - 1, "└" + hz + "┘", color)
        for yy in range(y + 1, y + h - 1):
            self.put(x, yy, "│", color)
            self.put(x + w - 1, yy, "│", color)
        if title:
            self.put(x + 2, y, "┤ ", color)
            self.put(x + 4, y, title, tcolor or color)
            self.put(x + 4 + len(title), y, " ├", color)

    def render(self):
        # Posiciona cada fila con su coordenada absoluta (no depende de '\n'):
        # evita el scroll de la esquina inferior y dibuja todas las filas.
        out = []
        for y in range(self.h):
            out.append("\033[%d;1H" % (y + 1))
            cur = None
            line = []
            row = self.ch[y]
            crow = self.co[y]
            for x in range(self.w):
                c = crow[x]
                if c != cur:
                    line.append(c)
                    cur = c
                line.append(row[x])
            line.append(RESET)
            out.append("".join(line))
        return "".join(out)

