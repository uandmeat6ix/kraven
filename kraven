def refresh_vitals():
    S.host = pick(HOSTS)
    S.os = pick(OSES)
    S.geo = pick(GEOS)
    S.mac = macr()

def step_scenario(fast):
    if S.paused or S.banner > 0:
        return
    if S.wait > 0:
        S.wait -= 1
        return
    if S.typing is not None:
        t = S.typing
        speed = len(t["full"]) if fast else rint(1, 3)
        t["idx"] = min(len(t["full"]), t["idx"] + speed)
        if t["idx"] >= len(t["full"]):
            S.push(t["prefix"] + [(t["full"], WHITE)])
            S.typing = None
            S.wait = 0 if fast else rint(2, 6)
        return
    try:
        item = next(GEN)
    except StopIteration:
        return
    kind = item[0]
    if kind == "cmd":
        S.typing = {"prefix": prompt_prefix(), "full": item[1], "idx": 0}
    elif kind == "out":
        S.push(item[1])
        S.wait = 0 if fast else rint(1, 4)
    elif kind == "wait":
        S.wait = max(1, item[1] // (3 if fast else 1))
    elif kind == "vitals":
        refresh_vitals()
    elif kind == "stage":
        _, pct, label, stage, inten = item
        S.m_pct, S.m_label, S.m_stage, S.intensity = pct, label, stage, inten
    elif kind == "banner":
        S.banner = 45
        S.banner_deny = item[1]
        S.g_ip = pick(HOSTS) + " · " + ipr()
    elif kind == "reset":
        S.shell = []
        S.prows = []
        S.pscanned = 0

