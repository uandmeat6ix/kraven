    wc = col if flick else WHITE
    cv.put(bx + (bw - len(word)) // 2, by + 2, word, wc)
    cv.put(bx + (bw - len(sub)) // 2, by + 4, sub, INKD)
    if S.g_ip:
        cv.put(bx + (bw - len(S.g_ip)) // 2, by + 5, S.g_ip, CYAN)

# ----------------------------------------------------------------------------
# Layout + un frame completo
# ----------------------------------------------------------------------------
def draw_frame(cv, clock):
    cv.clear()
    W, H = cv.w, cv.h
    if W < 74 or H < 20:
        msg = "Agranda la terminal (min 74x20) — KRAVEN"
        cv.put(max(0, (W - len(msg)) // 2), H // 2, msg[:W], AMBER)
        return

    draw_header(cv, clock)
    top = 1
    bottom = H - 2

    Lw = int(W * 0.56)
    total = bottom - top + 1
    mtxH = min(9, max(6, total // 3))
    shellH = total - mtxH

    # columna izquierda
    draw_shell(cv, 0, top, Lw, shellH)
    draw_matrix(cv, 0, top + shellH, Lw, mtxH)

    # columna derecha
    rx = Lw + 1
    rw = W - rx
    teleH = min(15, max(9, total // 2))
    hexH = mtxH
    portsH = total - teleH - hexH
    if portsH < 5:
        portsH = 5
        teleH = total - portsH - hexH
    draw_telemetry(cv, rx, top, rw, teleH)
    draw_ports(cv, rx, top + teleH, rw, portsH)
    draw_hex(cv, rx, top + teleH + portsH, rw, hexH)

    draw_footer(cv)

    if S.banner > 0:
        draw_banner(cv)

# ----------------------------------------------------------------------------
# Entrada de teclado (raw, no bloqueante) — solo si hay TTY
# ----------------------------------------------------------------------------
def inject_code():
    snip = pick(SNIPPETS).replace("%IP%", ipr())
    S.push(prompt_prefix() + [(snip, WHITE)])

def handle_keys(data):
    quit_ = False
    for b in data:
        ch = chr(b) if b < 128 else "?"
        if b == 3 or ch in ("q", "Q"):
            quit_ = True
        elif ch == " ":
            S.paused = not S.paused
        else:
            inject_code()
    return quit_

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
HELP = """KRAVEN — Hollywood remasterizado para la terminal (puro teatro).

  kraven            arranca la simulacion
  kraven --fast     sin efecto de tipeo, ritmo acelerado
  kraven --frames N renderiza N frames y sale (pruebas)
  kraven --help     esta ayuda

Teclas: cualquier tecla = inyecta codigo · ESPACIO = pausa · q / Ctrl+C = salir
"""

def main():
    args = sys.argv[1:]
    if "--help" in args or "-h" in args:
        sys.stdout.write(HELP)
        return 0
    fast = "--fast" in args
    max_frames = None
    if "--frames" in args:
        try:
            max_frames = int(args[args.index("--frames") + 1])
        except (IndexError, ValueError):
            max_frames = 60

    is_tty = sys.stdin.isatty() and sys.stdout.isatty()
    if max_frames is None and not is_tty:
        max_frames = 60  # evita colgarse si se ejecuta en un pipe

    old = None
    if is_tty:
        import termios
        import tty
        old = termios.tcgetattr(sys.stdin)
        tty.setraw(sys.stdin.fileno())
        sys.stdout.write("\033[?1049h\033[?25l")  # alt screen + hide cursor
        sys.stdout.flush()

    size = shutil.get_terminal_size((100, 32))
    cv = Canvas(size.columns, size.lines)
    refresh_vitals()

    import select
    dt = 0.045 if fast else 0.055
    rc = 0
    try:
        while True:
            # resize
            size = shutil.get_terminal_size((100, 32))
            if size.columns != cv.w or size.lines != cv.h:
                cv.resize(size.columns, size.lines)

            # input
            if is_tty:
                r, _, _ = select.select([sys.stdin], [], [], 0)
                if r:
                    data = os.read(sys.stdin.fileno(), 64)
                    if handle_keys(data):
                        break

            # update
            step_scenario(fast)
            update_gauges()
            update_ports()
            update_hex()
            if S.banner > 0:
                S.banner -= 1

            clock = time.strftime("%Y-%m-%d %H:%M:%SZ", time.gmtime())
            draw_frame(cv, clock)
            sys.stdout.write(cv.render())
            sys.stdout.flush()

            S.frame += 1
            if max_frames is not None and S.frame >= max_frames:
                break
            if not is_tty and max_frames is None:
                break
            time.sleep(dt)
    except KeyboardInterrupt:
        rc = 0
    finally:
        if is_tty and old is not None:
            import termios
            sys.stdout.write("\033[?25h\033[?1049l")  # show cursor + main screen
            sys.stdout.flush()
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old)
    return rc

if __name__ == "__main__":
    sys.exit(main())
